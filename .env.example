# Copie ce fichier en .env et remplis avec tes vraies clés

# Claude (génération créa + validation policies)
ANTHROPIC_API_KEY=sk-ant-...

# Arcads (génération vidéos UGC)
ARCADS_API_KEY=...

# Meta Marketing API (System User Token, PAS un user token)
# Comment l'obtenir: business.facebook.com → Business Settings → Users → System Users
# IMPORTANT : permissions requises = ads_management, ads_read, business_management,
# pages_show_list, pages_read_engagement, leads_retrieval (ce dernier pour le quality scoring)
META_ACCESS_TOKEN=EAA...

# Dashboard quotidien par email (SMTP Gmail)
# IMPORTANT : utilise un App Password Gmail, PAS le mot de passe du compte.
# Génère ici: https://myaccount.google.com/apppasswords (2FA doit être activé)
# Le SMTP_USER est l'expéditeur Gmail. Le destinataire est défini dans config/config.json.
SMTP_USER=ton.expediteur@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optionnel : override du serveur SMTP si tu veux pas Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# CRM Rappelle (Supabase) — push automatique des leads scorés vers inbound_leads
# Si ces 3 vars sont absentes, le push est désactivé et les leads restent dans data/leads.jsonl
# La SUPABASE_SERVICE_KEY est SECRÈTE — ne JAMAIS la commit ni la coller dans un chat.
# Récup : Supabase dashboard → Settings → API → "service_role" key (la longue qui commence par eyJ...)
SUPABASE_URL=https://fhzdljgprwxlfasvglfp.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...
SUPABASE_ORG_ID=82df0449-15f6-492e-9378-ce40cff1f97d
